NODE_ENV=development
APP_PORT=3052
API_PREFIX=/v1/api

# Prefer one URI. DB_* and the legacy DEV_DB_*/PROD_DB_* variables are also supported.
MONGODB_URI=mongodb://root:root123@localhost:27017/shopDEV?authSource=admin
DB_DEBUG=true
DB_MONITOR_INTERVAL_MS=300000

ACCESS_TOKEN_TTL=2d
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_MAX_AGE_MS=604800000
BCRYPT_SALT_ROUNDS=10
RSA_MODULUS_LENGTH=2048

# Required for POST /keys in production.
API_KEY_BOOTSTRAP_SECRET=replace-with-a-long-random-secret

LOG_LEVEL=debug
LOG_DIRECTORY=logs
LOG_FILES_ENABLED=false
JSON_BODY_LIMIT=1mb
TRUST_PROXY=false
