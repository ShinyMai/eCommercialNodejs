NODE_ENV=development
APP_PORT=3052
API_PREFIX=/v1/api

# Prefer one URI. When omitted, the application builds it from the DB_* variables.
MONGODB_URI=mongodb://root:root123@localhost:27017/ecommerceDEV?authSource=admin
REDIS_URL=redis://127.0.0.1:6379
DB_DEBUG=true
DB_MONITOR_INTERVAL_MS=300000

ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_ISSUER=ecommerce-api
ACCESS_TOKEN_AUDIENCE=ecommerce-client
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_COOKIE_MAX_AGE_MS=604800000
REFRESH_TOKEN_HISTORY_LIMIT=50
BCRYPT_SALT_ROUNDS=10
SEED_DEFAULT_PASSWORD=ChangeMe123!
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_LOGIN_RATE_MAX=20
AUTH_SIGNUP_RATE_WINDOW_MS=3600000
AUTH_SIGNUP_RATE_MAX=10
AUTH_REFRESH_RATE_WINDOW_MS=900000
AUTH_REFRESH_RATE_MAX=60

LOG_LEVEL=debug
LOG_DIRECTORY=logs
LOG_FILES_ENABLED=false
JSON_BODY_LIMIT=1mb
TRUST_PROXY=false
