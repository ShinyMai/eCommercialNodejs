@baseUrl = http://localhost:3052/v1/api
@accessToken = replace-with-access-token

### Health
GET {{baseUrl}}/health

### Sign up as buyer
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "name": "Buyer One",
  "email": "buyer@example.com",
  "password": "correct-horse-battery-staple"
}

### Sign up as seller
POST {{baseUrl}}/auth/signup/seller
Content-Type: application/json

{
  "name": "Seller One",
  "email": "seller@example.com",
  "password": "correct-horse-battery-staple",
  "storeName": "Seller Store",
  "storeDescription": "Example store"
}

### Log in (all roles)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "buyer@example.com",
  "password": "correct-horse-battery-staple"
}

### Refresh token (uses the httpOnly cookie returned by login/signup)
POST {{baseUrl}}/auth/refresh-token
Content-Type: application/json

{}

### Current account and user profile
GET {{baseUrl}}/accounts/me
Authorization: Bearer {{accessToken}}

### Update personal profile (sellerProfile is accepted for seller/admin only)
PATCH {{baseUrl}}/accounts/me/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated display name",
  "phone": "+84 900 000 000"
}

### Log out
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}
