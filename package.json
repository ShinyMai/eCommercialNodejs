{
  "name": "ecommerce_platform_be",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "scripts": {
    "dev": "node --conditions=development --import tsx --watch server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=development --import tsx --test tests/app.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "slugify": "^1.6.9",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "compression": "^1.8.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
